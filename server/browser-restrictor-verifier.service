[Unit]
Description=Browser Restrictor exercise verifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/browser_restrictor_android/server
EnvironmentFile=%h/.config/browser-restrictor-verifier.env
ExecStart=/usr/local/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
