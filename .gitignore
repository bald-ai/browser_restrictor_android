*.iml
.gradle/
.kotlin/
/local.properties
/.idea/
/build/
/app/build/
/captures/

# Keep personal notes out of Git.
# Project-facing Markdown documents must be explicitly allowed here.
*.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/DOCUMENTATION.md
!/AGENTS.md
!/AGENT_CAPABILITIES.md

.DS_Store
node_modules/

# V1 deployment credentials, local runtime state and private validation evidence.
/work/v1-build/
/backend-v1/.env
/backend-v1/data/

!/validation_artifacts/pulse/README.md

# Mark historical artifacts explicitly for future contributors.
!/design-preview/README.md
!/prototypes/README.md
!/validation_artifacts/README.md
!/review-reports/README.md

# Runtime app guide retrieved by the in-app assistant.
!/backend-v1/docs/app-guide.md
!/backend-v1/docs/app-overview.md

# Maintained reproducible assistant benchmark; generated runs stay local.
!/benchmarks/friction/README.md
/benchmarks/friction/runs/
!/quality/*.md
/quality/.venv/
/quality/parser/build/
/quality/__pycache__/
/quality/metrics/javascript/tmp/
!/benchmarks/friction/RESULTS.md

/quality/probes/build/

# Disposable verification output; manual runs clean it up.
/quality/logs
/quality/history
/app/build/reports
/app/build/test-results
/app/build/jacoco
/app/build/outputs/unit_test_code_coverage
/quality/PROGRESS.md
/.verification-session/
/**/__pycache__/
